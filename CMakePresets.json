{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSDL_WERROR": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-debug/bin"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer/UBSan",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSDL_WERROR": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-asan/bin"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "headless",
      "displayName": "Headless only (no SDL, no ImGui)",
      "description": "Builds only the SDL-free core and bin/csdl_headless; needs just a compiler and CMake.",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CSDL_BUILD_APP": "OFF" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "description": "MSVC x64 with Ninja. The IDE (Visual Studio, VS Code, CLion) sets up the compiler environment; on the command line, run from an x64 Native Tools prompt for Visual Studio.",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows",
      "displayName": "Windows Release (MSVC + vcpkg)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (MSVC + vcpkg)",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSDL_WERROR": "ON",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build-windows-debug/bin"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "windows-debug", "configurePreset": "windows-debug" }
  ]
}
